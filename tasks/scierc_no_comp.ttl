@prefix : <http://example.org/method-application#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix sd: <http://example.org/structured-decomposition#> .

# =============================================================================
# Method Application Ontology - WITHOUT Complementary Predicates
# =============================================================================
# This version contains only positive predicates needed for rule satisfaction.
# Under OWA, if the LLM fails to extract a predicate, the reasoner cannot
# determine whether it's false or simply unknown.
#
# Compare with method_application_comp.ttl which includes complementary
# predicates to force explicit negative determinations.
# =============================================================================

:MethodApplicationOntology a owl:Ontology ;
    rdfs:comment "Method application ontology without complementary predicates (baseline)" .

# =============================================================================
# Task Metadata (sd: namespace - for LLM prompting, not reasoning)
# =============================================================================

:MethodApplicationTask a sd:Task ;
    sd:domain "science" ;
    sd:subdomain "NLP_AI_research" ;
    sd:taskName "method_application" ;
    sd:persona "research assistant identifying usage relationships in scientific text" ;
    sd:question "Determine if the text explicitly states that the candidate method is being used to perform, solve, or improve the candidate task." ;
    sd:domainKnowledge """Analyze the relationship between the entity marked in [[ double brackets ]] (Candidate Method)
and the entity marked in << angle brackets >> (Candidate Task).

Rules for 'No':
- Answer No if the two entities are merely listed together (Conjunction).
- Answer No if the Method is just a component or feature of the Task (Part-Of/Feature-Of).
- Answer No if the relationship is a comparison (Compare).
- Answer No if the text describes a hierarchy (e.g., X is a type of Y).""" ;
    sd:targetClass :MethodApplication ;
    sd:targetTerm "m" .

# =============================================================================
# Entity Specifications (sd: namespace - guides entity extraction)
# =============================================================================

:entity_m a sd:EntitySpec ;
    sd:entityName "m" ;
    sd:entityDescription "The source entity marked in [[ double brackets ]]. Extract the exact text between [[ and ]]." ;
    sd:mapsToClass :Method .

:entity_t a sd:EntitySpec ;
    sd:entityName "t" ;
    sd:entityDescription "The target entity marked in << angle brackets >>. Extract the exact text between << and >>." ;
    sd:mapsToClass :ScientificTask .

# =============================================================================
# Assertion Specifications (sd: namespace - guides predicate extraction)
# =============================================================================
# NOTE: This version contains ONLY positive predicates.
# No complementary (negative) predicates are defined.
# =============================================================================

:assert_FunctionalConnection a sd:AssertionSpec ;
    sd:assertionName "FunctionalConnection" ;
    sd:assertionEntities "m, t" ;
    sd:assertionDescription """True if the text indicates m serves a FUNCTION related to t. Accept any of these patterns:
1. DIRECT USAGE: 'm used for t', 'm applied to t', 'm to perform t', 'm enables t'
2. PURPOSE: 'm for t', 'm for the task of t', 'm as a tool for t', 'm designed for t'
3. APPLICATION DOMAIN: 'm with applications in t', 'm in domain of t', 'application of m to t'
4. REVERSED CONSTRUCTIONS: 't based on m', 't using m', 't trained on m', 't parsed with m'
5. IMPLICIT: m appears as technique/method and t as goal/task with purposive connection""" ;
    sd:mapsToProperty :functionallyConnectsTo .

:assert_NotExcludedRelationType a sd:AssertionSpec ;
    sd:assertionName "NotExcludedRelationType" ;
    sd:assertionEntities "m, t" ;
    sd:assertionDescription """True if the relationship between m and t is NOT one of the excluded types. Check that the relationship is NOT:
- CONJUNCTION: m and t listed together with 'and'/'or', serving parallel roles
- COMPARISON: m compared/contrasted with t ('versus', 'outperforms', 'better than')
- PART-OF: m is a component/module of t
- HYPONYM: m is a type/kind of t
- FEATURE-OF: m is a property/attribute/metric of t""" ;
    sd:mapsToProperty :hasValidRelationTypeWith .

# =============================================================================
# OWL Classes (TBox)
# =============================================================================

:Method a owl:Class ;
    rdfs:comment "A computational method, technique, or approach" .

:ScientificTask a owl:Class ;
    owl:disjointWith :Method ;
    rdfs:comment "A scientific task, problem, or application domain" .

:MethodApplication a owl:Class ;
    rdfs:subClassOf :Method ;
    rdfs:comment "A method that is functionally applied to a scientific task" .

# =============================================================================
# OWL Object Properties
# =============================================================================

:functionallyConnectsTo a owl:ObjectProperty ;
    rdfs:domain :Method ;
    rdfs:range :ScientificTask ;
    rdfs:comment "Indicates the method serves a function related to the task" .

:hasValidRelationTypeWith a owl:ObjectProperty ;
    rdfs:domain :Method ;
    rdfs:range :ScientificTask ;
    rdfs:comment "Indicates the relationship is not an excluded type (conjunction, comparison, etc.)" .

# =============================================================================
# SWRL Rule
# =============================================================================
# Method(?m) ∧ ScientificTask(?t) ∧ functionallyConnectsTo(?m, ?t) 
#   ∧ hasValidRelationTypeWith(?m, ?t) → MethodApplication(?m)
# =============================================================================

:MethodApplicationRule a swrl:Imp ;
    rdfs:comment "Method application classification rule" ;
    swrl:body [ 
        a swrl:AtomList ;
        rdf:first [ a swrl:ClassAtom ; swrl:classPredicate :Method ; swrl:argument1 :var_m ] ;
        rdf:rest [ 
            a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ; swrl:classPredicate :ScientificTask ; swrl:argument1 :var_t ] ;
            rdf:rest [ 
                a swrl:AtomList ;
                rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :functionallyConnectsTo ; swrl:argument1 :var_m ; swrl:argument2 :var_t ] ;
                rdf:rest [ 
                    a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasValidRelationTypeWith ; swrl:argument1 :var_m ; swrl:argument2 :var_t ] ;
                    rdf:rest rdf:nil 
                ]
            ]
        ]
    ] ;
    swrl:head [ 
        a swrl:AtomList ;
        rdf:first [ a swrl:ClassAtom ; swrl:classPredicate :MethodApplication ; swrl:argument1 :var_m ] ;
        rdf:rest rdf:nil 
    ] .

# SWRL Variables
:var_m a swrl:Variable .
:var_t a swrl:Variable .
